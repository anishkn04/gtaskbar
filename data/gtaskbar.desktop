[Desktop Entry]
Type=Application
Name=GTaskbar
GenericName=Google Tasks Client
Comment=A native, tray-first Google Tasks client for Linux
# @bindir@ is replaced with the real install directory by install.sh.
#
# The path has to be absolute. The spec resolves a bare command name through
# $PATH, and ~/.local/bin is not on the PATH of the graphical session, only of
# an interactive shell, so "gtaskbar" here failed to exec from the app picker
# and from XDG autostart with no error at all.
#
# No %U either: the app has no MimeType and no HANDLES_OPEN flag, so GIO would
# treat the substituted URL as a file to open and exit 1.
Exec=@bindir@/gtaskbar
Icon=gtaskbar
Terminal=false
Categories=GNOME;GTK;Utility;
Keywords=google;tasks;todo;to-do;checklist;gtd;
StartupNotify=true
StartupWMClass=dev.anishkn04.gtaskbar
SingleMainWindow=true
X-GNOME-UsesNotifications=true
