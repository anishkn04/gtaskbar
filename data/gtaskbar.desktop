[Desktop Entry]
Type=Application
Name=GTaskbar
GenericName=Google Tasks Client
Comment=A native, tray-first Google Tasks client for Linux
# No %U: the app has no MimeType and no HANDLES_OPEN flag, so GIO treats any
# argument as a file to open and exits 1 with "This application can not open
# files". The app takes no arguments.
Exec=gtaskbar
Icon=gtaskbar
Terminal=false
Categories=GNOME;GTK;Utility;
Keywords=google;tasks;todo;to-do;checklist;gtd;
StartupNotify=true
StartupWMClass=dev.anishkn04.gtaskbar
SingleMainWindow=true
X-GNOME-UsesNotifications=true
