[Desktop Entry]
Type=Application
Name=GTaskbar
GenericName=Google Tasks Client
Comment=A native, tray-first Google Tasks client for Linux
# @bindir@ is replaced with the real install directory by install.sh; see
# data/gtaskbar.desktop for why this cannot be a bare command name.
Exec=@bindir@/gtaskbar --hidden
Icon=gtaskbar
Terminal=false
Categories=GNOME;GTK;Utility;
# Autostart entries live in the application menu unless this is true, which
# put a second, duplicate "GTaskbar" entry in the launcher next to the real
# one. This entry is only meant to be started by the session.
NoDisplay=true
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=3
X-GNOME-UsesNotifications=true
